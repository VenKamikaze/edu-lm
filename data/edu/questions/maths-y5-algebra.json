      "type": "multiple_choice",
      "prompt": "Ravi knows that 6 × 8 = 48. Which sum is in the same fact family?",
      "choices": [
        "48 ÷ 6 = 9",
        "8 ÷ 48 = 6",
        "48 ÷ 6 = 8",
        "48 − 8 = 6"
      ],
      "answer": 2,
      "difficulty": 1,
      "explanation": "Division undoes multiplication. Since 6 groups of 8 make 48, sharing 48 into 6 groups gives 8."
    },
    {
      "id": "m5-alg-0002",
