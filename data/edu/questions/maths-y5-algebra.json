      "subject": "maths",
      "curriculum": "AC9M5A01",
      "type": "multiple_choice",
      "prompt": "Tom knows that 25 × 16 = 400. Which division must also be true?",
      "choices": [
        "400 ÷ 25 = 16",
        "400 ÷ 40 = 25",
        "16 ÷ 400 = 25",
        "25 ÷ 16 = 400"
      ],
      "answer": 0,
      "difficulty": 3,
      "explanation": "The whole (400) is divided by one of the two factors to give the other factor. 400 ÷ 25 = 16."
    },
